      "name": "(1) Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {\r",
              "  var loginResponse = pm.response.json();\r",
              "  console.log(\"Token capturado: \" + loginResponse.token);\r",
              "  console.log(\"User ID capturado: \" + loginResponse.userId);\r",
              "  pm.environment.set(\"token\", loginResponse.token);\r",
              "  pm.environment.set(\"userId\", loginResponse.userId);\r",
              "}\r",
              ""
