      "name": "(0) CreateUser",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.code === 201 && (() => {\r",
              "  var userId = pm.response.json().id;\r",
              "  console.log(\"User ID capturado: \" + userId);\r",
              "  pm.environment.set(\"userId\", userId);\r",
              "})()\r",
              ""
